+    /**
+     * Complete only the primary LTE channel metadata that some vendor HALs leave as unknown.
+     * CellIdentityLte is accepted as the fallback solely when its PCI identifies the same
+     * primary cell. Secondary carriers and every other radio type remain untouched.
+     */
+    private List<PhysicalChannelConfig> completeLtePhysicalChannelConfigs(
+            List<PhysicalChannelConfig> configs, ServiceState ss) {
+        if (configs == null || configs.isEmpty() || ss == null) {
+            return configs;
+        }
+        NetworkRegistrationInfo regInfo = ss.getNetworkRegistrationInfo(
+                NetworkRegistrationInfo.DOMAIN_PS,
+                AccessNetworkConstants.TRANSPORT_TYPE_WWAN);
+        CellIdentity cellIdentity = regInfo == null ? null : regInfo.getCellIdentity();
+        if (!(cellIdentity instanceof CellIdentityLte)) {
+            return configs;
+        }
+        CellIdentityLte lteIdentity = (CellIdentityLte) cellIdentity;
+        int primaryPci = lteIdentity.getPci();
+        if (primaryPci == PhysicalChannelConfig.PHYSICAL_CELL_ID_UNKNOWN) {
+            return configs;
+        }
+
+        int fallbackBand = PhysicalChannelConfig.BAND_UNKNOWN;
+        int[] bands = lteIdentity.getBands();
+        if (bands != null) {
+            for (int band : bands) {
+                if (band <= PhysicalChannelConfig.BAND_UNKNOWN) {
+                    continue;
+                }
+                if (fallbackBand != PhysicalChannelConfig.BAND_UNKNOWN) {
+                    fallbackBand = PhysicalChannelConfig.BAND_UNKNOWN;
+                    break;
+                }
+                fallbackBand = band;
+            }
+        }
+        int fallbackChannel = lteIdentity.getEarfcn();
+        boolean changed = false;
+        List<PhysicalChannelConfig> completed = new ArrayList<>(configs.size());
+        for (PhysicalChannelConfig config : configs) {
+            if (config == null
+                    || config.getConnectionStatus()
+                    != PhysicalChannelConfig.CONNECTION_PRIMARY_SERVING
+                    || config.getNetworkType() != TelephonyManager.NETWORK_TYPE_LTE
+                    || config.getPhysicalCellId() != primaryPci) {
+                completed.add(config);
+                continue;
+            }
+
+            int configBand = config.getBand();
+            int configChannel = config.getDownlinkChannelNumber();
+            boolean needsBand = configBand == PhysicalChannelConfig.BAND_UNKNOWN
+                    && fallbackBand != PhysicalChannelConfig.BAND_UNKNOWN;
+            boolean needsChannel = (configChannel <= 0
+                    || configChannel == PhysicalChannelConfig.CHANNEL_NUMBER_UNKNOWN)
+                    && fallbackChannel > 0
+                    && fallbackChannel != PhysicalChannelConfig.CHANNEL_NUMBER_UNKNOWN;
+            if (!needsBand && !needsChannel) {
+                completed.add(config);
+                continue;
+            }
+
+            PhysicalChannelConfig.Builder builder = new PhysicalChannelConfig.Builder(config);
+            if (needsBand) {
+                builder.setBand(fallbackBand);
+            }
+            if (needsChannel) {
+                builder.setDownlinkChannelNumber(fallbackChannel);
+            }
+            completed.add(builder.build());
+            changed = true;
+        }
+        if (!changed) {
+            return configs;
+        }
+        log("Completed primary LTE PhysicalChannelConfig from matching CellIdentityLte: band="
+                + fallbackBand + ", earfcn=" + fallbackChannel + ", pci=" + primaryPci);
+        return completed;
+    }
