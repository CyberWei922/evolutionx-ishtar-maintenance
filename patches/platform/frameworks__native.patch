diff --git a/services/surfaceflinger/IshtarAlsFrameHint.cpp b/services/surfaceflinger/IshtarAlsFrameHint.cpp
new file mode 100644
index 0000000..0146d63
--- /dev/null
+++ b/services/surfaceflinger/IshtarAlsFrameHint.cpp
@@ -0,0 +1,161 @@
+// ishtar .307 under-display ALS expects CWB refresh hints from the compositor.
+// Wire layout verified against matching BpHwCitSensorService::_hidl_transfer_msg
+// and CitSensorService::transfer_msg; -9 only refreshes the screen sample.
+#ifdef LOG_TAG
+#undef LOG_TAG
+#endif
+#define LOG_TAG "IshtarAlsFrameHint"
+#include "IshtarAlsFrameHint.h"
+#include <android-base/properties.h>
+#include <hidl/HidlBinderSupport.h>
+#include <hidl/ServiceManagement.h>
+#include <hidl/Status.h>
+#include <hwbinder/IBinder.h>
+#include <hwbinder/Parcel.h>
+#include <log/log.h>
+#include <sys/eventfd.h>
+#include <sys/resource.h>
+#include <poll.h>
+#include <pthread.h>
+#include <sched.h>
+#include <unistd.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <thread>
+
+namespace android {
+namespace {
+using Clock = std::chrono::steady_clock;
+constexpr char kDescriptor[] = "vendor.xiaomi.sensor.citsensorservice@2.0::ICitSensorService";
+constexpr auto kMinInterval = std::chrono::milliseconds(300);
+constexpr auto kSettleDelay = std::chrono::milliseconds(20);
+
+class FrameHintWorker {
+public:
+    FrameHintWorker() : mEventFd(eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK)) {
+        if (mEventFd >= 0) std::thread([this] { run(); }).detach();
+        else ALOGE("Cannot create ALS frame hint eventfd: %s", strerror(errno));
+    }
+    // No Binder, mutex wait, allocation, or sleeping on the compositor thread.
+    void notify(const sp<Fence>& presentFence) {
+        if (mEventFd < 0) return;
+        const int fenceFd = presentFence != nullptr ? presentFence->dup() : -1;
+        const int replaced = mFenceFd.exchange(fenceFd, std::memory_order_acq_rel);
+        if (replaced >= 0) close(replaced);
+        if (mPending.exchange(true, std::memory_order_acq_rel)) return;
+        uint64_t value = 1;
+        ssize_t n;
+        do { n = write(mEventFd, &value, sizeof(value)); } while (n < 0 && errno == EINTR);
+        if (n != static_cast<ssize_t>(sizeof(value))) mPending.store(false, std::memory_order_release);
+    }
+private:
+    status_t send() {
+        using namespace hardware;
+        if (mBinder == nullptr) {
+            auto service = details::getRawServiceInternal(kDescriptor, "default", false, false);
+            if (service == nullptr || !service->isRemote()) return NAME_NOT_FOUND;
+            mBinder = getOrCreateCachedBinder(service.get());
+            if (mBinder == nullptr) return NAME_NOT_FOUND;
+        }
+        // Fixed-size POD message. No strings, vectors, calibration or setting writes.
+        std::array<unsigned char, 264> msg{};
+        constexpr float refreshCommand = -9.0f;
+        memcpy(msg.data() + 12, &refreshCommand, sizeof(refreshCommand));
+        Parcel data, reply;
+        size_t handle = 0;
+        status_t rc = data.writeInterfaceToken(kDescriptor);
+        if (rc == OK) rc = data.writeBuffer(msg.data(), msg.size(), &handle);
+        bool callback = false;
+        status_t response = UNKNOWN_ERROR;
+        if (rc == OK) {
+            rc = mBinder->transact(4, data, &reply, 0, [&](Parcel& p) {
+                callback = true;
+                Status status;
+                response = readFromParcel(&status, p);
+                if (response == OK && !status.isOk()) response = UNKNOWN_ERROR;
+                if (response == OK) {
+                    const void* returned = nullptr;
+                    size_t returnedHandle;
+                    response = p.readBuffer(msg.size(), &returnedHandle, &returned);
+                    if (response == OK && memcmp(returned, msg.data(), msg.size()) != 0)
+                        response = BAD_VALUE;
+                }
+            });
+        }
+        if (rc != OK) { mBinder.clear(); return rc; }
+        return callback ? response : UNKNOWN_ERROR;
+    }
+    void run() {
+        // Never inherit the compositor's latency-sensitive scheduler priority.
+        pthread_setname_np(pthread_self(), "ishtar-als-hint");
+        sched_param normal{};
+        if (sched_setscheduler(0, SCHED_OTHER, &normal) != 0)
+            ALOGW("Cannot reset ALS worker scheduler: %s", strerror(errno));
+        setpriority(PRIO_PROCESS, 0, 10);
+        auto previous = Clock::time_point::min();
+        auto lastWarning = Clock::time_point::min();
+        uint64_t successCount = 0;
+        for (;;) {
+            pollfd pfd{mEventFd, POLLIN, 0};
+            int ready;
+            do { ready = poll(&pfd, 1, -1); } while (ready < 0 && errno == EINTR);
+            if (ready <= 0) return;
+            uint64_t count;
+            ssize_t n;
+            do { n = read(mEventFd, &count, sizeof(count)); } while (n < 0 && errno == EINTR);
+            if (n != static_cast<ssize_t>(sizeof(count))) continue;
+            // Coalesce burst frames and keep the trailing update for a static screen.
+            auto due = Clock::now() + kSettleDelay;
+            if (previous != Clock::time_point::min()) due = std::max(due, previous + kMinInterval);
+            std::this_thread::sleep_until(due);
+            // Clear pending before taking the latest fence: a concurrent later
+            // presentation then necessarily queues another trailing notification.
+            mPending.store(false, std::memory_order_release);
+            const int fenceFd = mFenceFd.exchange(-1, std::memory_order_acq_rel);
+            bool presented = true;
+            if (fenceFd >= 0) {
+                pollfd fencePoll{fenceFd, POLLIN, 0};
+                int signaled;
+                do { signaled = poll(&fencePoll, 1, 1000); }
+                while (signaled < 0 && errno == EINTR);
+                presented = signaled > 0 && (fencePoll.revents & POLLIN);
+                close(fenceFd);
+            }
+            status_t rc = presented ? send() : TIMED_OUT;
+            previous = Clock::now();
+            if (rc == OK) {
+                if (++successCount == 1) ALOGI("Original ALS CWB frame refresh connected");
+            } else if (lastWarning == Clock::time_point::min() || previous - lastWarning > std::chrono::seconds(30)) {
+                ALOGW("ALS frame refresh unavailable: %d", rc);
+                lastWarning = previous;
+            }
+            if (fenceFd < 0 && rc == OK) {
+                // Without a reliable present fence, one bounded trailing refresh
+                // covers late presentation. Never create a recurring idle timer.
+                std::this_thread::sleep_until(previous + kMinInterval);
+                if (!mPending.load(std::memory_order_acquire)) {
+                    send();
+                    previous = Clock::now();
+                }
+            }
+        }
+    }
+    const int mEventFd;
+    std::atomic<bool> mPending{false};
+    std::atomic<int> mFenceFd{-1};
+    sp<hardware::IBinder> mBinder;
+};
+} // namespace
+
+void notifyIshtarAlsContentChanged(const sp<Fence>& presentFence) {
+    static const bool enabled = base::GetBoolProperty("ro.surface_flinger.ishtar_als_frame_hint", false);
+    if (!enabled) return;
+    // Process lifetime matches SurfaceFlinger; no shutdown work on its main thread.
+    static FrameHintWorker* const worker = new FrameHintWorker;
+    worker->notify(presentFence);
+}
+} // namespace android
