+void ThermalUtils::appendSkinTemperature(std::vector<Temperature>& temperatures) {
+    IshtarSkin::Sample sample;
+    if (skin.read(sample)) temperatures.push_back(skinTemperature(sample));
+}
+
+void ThermalUtils::appendSkinThreshold(std::vector<TemperatureThreshold>& thresholds) {
+    if (!skin.enabled()) return;
+    TemperatureThreshold threshold;
+    threshold.type = TemperatureType::SKIN;
+    threshold.name = IshtarSkin::kName;
+    const auto hot = IshtarSkin::hotThresholds();
+    threshold.hotThrottlingThresholds.assign(hot.begin(), hot.end());
+    threshold.coldThrottlingThresholds.assign(hot.size(), std::numeric_limits<float>::quiet_NaN());
+    thresholds.push_back(std::move(threshold));
+}
