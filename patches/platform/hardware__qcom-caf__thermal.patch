@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <array>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+
+namespace aidl::android::hardware::thermal {
+
+// A read-only implementation of ishtar's factory VIRTUAL-SENSOR0 board model.
+// It reports Android thermal information; mi_thermald retains all device control.
+class IshtarSkin {
+  public:
+    struct Sample {
+        float celsius;
+        int severity;  // Android ThrottlingSeverity NONE..EMERGENCY (0..5).
+    };
+    using Callback = std::function<void(const Sample&)>;
+    static constexpr const char* kName = "ishtar-skin";
+    static constexpr size_t kSensorCount = 7;
+
+    explicit IshtarSkin(bool enabled, std::string sysfsRoot = "/sys/class/thermal");
+    ~IshtarSkin();
+    IshtarSkin(const IshtarSkin&) = delete;
+    IshtarSkin& operator=(const IshtarSkin&) = delete;
+
+    bool enabled() const { return enabled_; }
+    bool isInitialized() const;
+    bool read(Sample& sample);
+    // Start only after the callback owner's members are fully constructed.
+    bool start(Callback callback);
+    void stop();  // Interruptible wait and join, before the callback owner is destroyed.
+
+    static const std::array<const char*, kSensorCount>& sensorNames();
+    static std::array<float, 7> hotThresholds();
+    static bool calculate(const std::array<int, kSensorCount>& millidegrees, float& celsius);
+    static int estimateSeverity(float celsius, int previousSeverity);
+
+  private:
+    bool resolveLocked();
+    void monitor(Callback callback);
+
+    const bool enabled_;
+    const std::string sysfsRoot_;
+    mutable std::mutex sensorMutex_;
+    std::array<std::string, kSensorCount> paths_{};
+    bool initialized_ = false;
+    int previousSeverity_ = 0;
+    std::mutex lifecycleMutex_;
+    std::mutex waitMutex_;
+    std::condition_variable wake_;
+    bool stopping_ = true;
+    std::thread monitorThread_;
+};
+
+}  // namespace aidl::android::hardware::thermal
