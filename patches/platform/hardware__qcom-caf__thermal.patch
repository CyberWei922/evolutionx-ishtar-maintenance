+/* SPDX-License-Identifier: Apache-2.0 */
+#include "IshtarSkin.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <dirent.h>
+#include <fstream>
+#include <limits>
+#include <sstream>
+#include <system_error>
+#include <utility>
+
+namespace aidl::android::hardware::thermal {
+namespace {
+constexpr std::array<const char*, IshtarSkin::kSensorCount> kSensorNames = {
+        "battery", "pa_therm0", "pa_therm1", "quiet_therm",
+        "charger_therm0", "wifi_therm", "cpu_therm"};
+// Factory VIRTUAL-SENSOR0 uses a divisor of 1000, although these weights sum to 923.
+constexpr std::array<int, IshtarSkin::kSensorCount> kWeights = {471, 12, 23, 242, 31, 11, 133};
+constexpr int kWeightDivisor = 1000;
+constexpr int kCompensationMillidegrees = 1732;
+// Android severity mapping derived from ishtar's factory CPU3/7 mitigation policy.
+// These are an adaptation, not severity labels supplied by Xiaomi. No shutdown
+// threshold is inferred; mi_thermald and the kernel keep their existing controls.
+constexpr float kNaN = std::numeric_limits<float>::quiet_NaN();
+constexpr std::array<float, 7> kHotThresholds = {kNaN, 39.f, 41.f, 45.f, 48.f, 50.f, kNaN};
+constexpr std::array<float, 6> kClearThresholds = {kNaN, 37.f, 39.f, 44.f, 46.f, 48.f};
+
+bool readToken(const std::string& path, std::string& token) {
+    std::ifstream file(path);
+    std::string extra;
+    return (file >> token) && !(file >> extra);
+}
+
+bool readMillidegrees(const std::string& path, int& temperature) {
+    std::string token;
+    if (!readToken(path, token)) return false;
+    errno = 0;
+    char* end = nullptr;
+    const long value = std::strtol(token.c_str(), &end, 10);
+    if (errno || end == token.c_str() || *end || value < -40000 || value > 125000) {
+        return false;
+    }
+    temperature = static_cast<int>(value);
+    return true;
+}
+}  // namespace
+
+IshtarSkin::IshtarSkin(bool enabled, std::string sysfsRoot)
+    : enabled_(enabled), sysfsRoot_(std::move(sysfsRoot)) {
+    Sample initial;
+    if (enabled_) read(initial);  // No thread or callback during construction.
+}
+
+IshtarSkin::~IshtarSkin() {
+    stop();
+}
+
+const std::array<const char*, IshtarSkin::kSensorCount>& IshtarSkin::sensorNames() {
+    return kSensorNames;
+}
+
+std::array<float, 7> IshtarSkin::hotThresholds() {
+    return kHotThresholds;
+}
+
+bool IshtarSkin::calculate(const std::array<int, kSensorCount>& temperatures, float& celsius) {
+    int64_t weighted = 0;
+    for (size_t i = 0; i < temperatures.size(); ++i) {
+        if (temperatures[i] < -40000 || temperatures[i] > 125000) return false;
+        weighted += static_cast<int64_t>(temperatures[i]) * kWeights[i];
+    }
+    // Positive compensation was checked against the live factory board_sensor_temp.
+    celsius = static_cast<float>(weighted / kWeightDivisor + kCompensationMillidegrees) / 1000.f;
+    return std::isfinite(celsius);
+}
+
+int IshtarSkin::estimateSeverity(float celsius, int previousSeverity) {
+    if (!std::isfinite(celsius)) return -1;
+    for (int severity = 5; severity > 0; --severity) {
+        if (celsius >= kHotThresholds[severity] ||
+            (previousSeverity >= severity && celsius >= kClearThresholds[severity])) {
+            return severity;
+        }
+    }
+    return 0;
+}
+
+bool IshtarSkin::resolveLocked() {
+    paths_.fill("");
+    DIR* directory = opendir(sysfsRoot_.c_str());
+    if (!directory) return false;
+    for (dirent* entry; (entry = readdir(directory)) != nullptr;) {
+        const std::string name(entry->d_name);
+        if (name.rfind("thermal_zone", 0) != 0 || name.size() == 12 ||
+            !std::all_of(name.begin() + 12, name.end(), [](unsigned char c) {
+                return c >= '0' && c <= '9';
+            })) continue;
+        const std::string zone = sysfsRoot_ + "/" + name;
+        std::string type;
+        if (!readToken(zone + "/type", type)) continue;
+        for (size_t i = 0; i < kSensorNames.size(); ++i) {
+            if (type == kSensorNames[i]) paths_[i] = zone + "/temp";
+        }
+    }
+    closedir(directory);
+    return std::all_of(paths_.begin(), paths_.end(), [](const auto& path) { return !path.empty(); });
+}
+
+bool IshtarSkin::isInitialized() const {
+    std::lock_guard<std::mutex> lock(sensorMutex_);
+    return enabled_ && initialized_;
+}
+
+bool IshtarSkin::read(Sample& sample) {
+    std::lock_guard<std::mutex> lock(sensorMutex_);
+    if (!enabled_) return false;
+    if (std::any_of(paths_.begin(), paths_.end(), [](const auto& path) { return path.empty(); }) &&
+        !resolveLocked()) {
+        initialized_ = false;
+        return false;
+    }
+    std::array<int, kSensorCount> values{};
+    for (size_t i = 0; i < paths_.size(); ++i) {
+        if (!readMillidegrees(paths_[i], values[i])) {
+            paths_.fill("");  // Re-resolve by type after disappearance or re-enumeration.
+            initialized_ = false;
+            return false;  // No stale temperature or synthetic NONE status is published.
+        }
+    }
+    float celsius;
+    if (!calculate(values, celsius)) {
+        initialized_ = false;
+        return false;
+    }
+    previousSeverity_ = estimateSeverity(celsius, previousSeverity_);
+    initialized_ = true;
+    sample = {celsius, previousSeverity_};
+    return true;
+}
+
+bool IshtarSkin::start(Callback callback) {
+    std::lock_guard<std::mutex> lock(lifecycleMutex_);
+    if (!enabled_ || !callback) return false;
+    if (monitorThread_.joinable()) return true;
+    {
+        std::lock_guard<std::mutex> waitLock(waitMutex_);
+        stopping_ = false;
+    }
+    try {
+        monitorThread_ = std::thread(&IshtarSkin::monitor, this, std::move(callback));
+    } catch (const std::system_error&) {
+        std::lock_guard<std::mutex> waitLock(waitMutex_);
+        stopping_ = true;
+        return false;
+    }
+    return true;
+}
+
+void IshtarSkin::stop() {
+    std::lock_guard<std::mutex> lock(lifecycleMutex_);
+    {
+        std::lock_guard<std::mutex> waitLock(waitMutex_);
+        stopping_ = true;
+    }
+    wake_.notify_all();
+    if (monitorThread_.joinable()) monitorThread_.join();
+}
+
+void IshtarSkin::monitor(Callback callback) {
+    int lastNotifiedSeverity = -1;
+    std::unique_lock<std::mutex> waitLock(waitMutex_);
+    while (!stopping_) {
+        waitLock.unlock();
+        Sample sample;
+        if (read(sample) && sample.severity != lastNotifiedSeverity) {
+            // Callback is outside both sensorMutex_ and waitMutex_; callers can read.
+            callback(sample);
+            lastNotifiedSeverity = sample.severity;
+        }
+        waitLock.lock();
+        wake_.wait_for(waitLock, std::chrono::seconds(2), [this] { return stopping_; });
+    }
+}
+
+}  // namespace aidl::android::hardware::thermal
