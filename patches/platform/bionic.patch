+    // Explicit opens and metadata queries must agree so apps can load its labels.
+    // Directory discovery still uses is_rom_path() and remains filtered.
+    if (strcmp(path, "/system/framework/org.lineageos.platform-res.apk") == 0) return false;
+    return is_rom_path(path);
+}
