+  def test_Append_require_excludes_actual_providers_only(self):
+    self.write('in.pb', LinkerConfig(provideLibs=['libfoo.so'],
+                                    requireLibs=['libprior.so']).SerializeToString())
+    self.command(['append', '-s', FileArg('in.pb'), '-o', FileArg('out.pb'),
+                  '--key', 'requireLibs', '--value', 'libfoo.so libmissing.so',
+                  '--exclude-provided'])
+    pb = LinkerConfig()
+    pb.ParseFromString(self.read('out.pb'))
+    self.assertSequenceEqual(pb.provideLibs, ['libfoo.so'])
+    self.assertSequenceEqual(pb.requireLibs, ['libprior.so', 'libmissing.so'])
+
+
+  def test_Append_default_still_rejects_provider_requirement_overlap(self):
+    self.write('in.pb', LinkerConfig(provideLibs=['libfoo.so']).SerializeToString())
+    with self.assertRaises(SystemExit) as err:
+      with redirect_stderr(io.StringIO()):
+        self.command(['append', '-s', FileArg('in.pb'), '-o', FileArg('out.pb'),
+                      '--key', 'requireLibs', '--value', 'libfoo.so'])
+    self.assertEqual(err.exception.code, 1)
+    self.assertFalse(os.path.exists(os.path.join(self.tempdir, 'out.pb')))
+
+
+  def test_Append_exclusion_does_not_sanitize_invalid_existing_input(self):
+    self.write('in.pb', LinkerConfig(provideLibs=['libfoo.so'],
+                                    requireLibs=['libfoo.so']).SerializeToString())
+    with self.assertRaises(SystemExit) as err:
+      with redirect_stderr(io.StringIO()):
+        self.command(['append', '-s', FileArg('in.pb'), '-o', FileArg('out.pb'),
+                      '--key', 'requireLibs', '--value', 'libbar.so',
+                      '--exclude-provided'])
+    self.assertEqual(err.exception.code, 1)
+    self.assertFalse(os.path.exists(os.path.join(self.tempdir, 'out.pb')))
+
+
+  def test_Append_exclusion_rejects_wrong_field(self):
+    self.write('in.pb', LinkerConfig().SerializeToString())
