+# Preserve the current owner-tested engineering boot mode from full07-permissive-02.
+# Enforcing policy adaptation is a separate task; AVB configuration is unchanged.
+BOARD_BOOTCONFIG += androidboot.selinux=permissive
+BOARD_KERNEL_CMDLINE += androidboot.selinux=permissive enforcing=0
+
 # Properties
+TARGET_SYSTEM_PROP += $(DEVICE_PATH)/properties/camera-system.prop
 TARGET_ODM_PROP += $(DEVICE_PATH)/properties/odm.prop
 TARGET_PRODUCT_PROP += $(DEVICE_PATH)/properties/product.prop
