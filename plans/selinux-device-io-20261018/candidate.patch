--- a/device/xiaomi/ishtar/sepolicy/vendor/property.te
+++ b/device/xiaomi/ishtar/sepolicy/vendor/property.te
@@ -10,3 +10,6 @@
 
 # libmt@1.3 reports RKP provisioning status; keep ownership vendor-side.
 vendor_restricted_prop(vendor_mtd_rkp_status_prop)
+
+# Shipped libmt@1.3 reports device-attestation reload status.
+vendor_restricted_prop(vendor_mtd_attestation_status_prop)
--- a/device/xiaomi/ishtar/sepolicy/vendor/property_contexts
+++ b/device/xiaomi/ishtar/sepolicy/vendor/property_contexts
@@ -9,3 +9,6 @@
 
 # Exact libmt@1.3 output; do not relabel the persist.vendor.sys prefix.
 persist.vendor.sys.rkp.status u:object_r:vendor_mtd_rkp_status_prop:s0 exact string
+
+# Exact status output; keep the surrounding persist.vendor.sys prefix intact.
+persist.vendor.sys.attestation.status u:object_r:vendor_mtd_attestation_status_prop:s0 exact string
--- a/device/xiaomi/ishtar/sepolicy/vendor/vendor_mtd.te
