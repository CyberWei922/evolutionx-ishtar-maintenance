# Filesystem tools
/system/bin/fsck\.ntfs                  u:object_r:fsck_exec:s0
/system/bin/mkfs\.exfat                 u:object_r:mkfs_exec:s0
/system/bin/mkfs\.f2fs                  u:object_r:mkfs_exec:s0
/system/bin/mkfs\.ntfs                  u:object_r:mkfs_exec:s0

# OTA packages
/data/evolution_updates(/.*)?           u:object_r:ota_package_file:s0

# Postinstall
/system/bin/backuptool_ab\.functions              u:object_r:postinstall_exec:s0
/system/bin/backuptool_ab\.sh                     u:object_r:postinstall_exec:s0
/system/bin/backuptool_postinstall\.sh            u:object_r:postinstall_exec:s0

# ADB Root
/(system_ext|system/system_ext)/bin/adb_root      u:object_r:adbroot_exec:s0
/data/adbroot(/.*)?        u:object_r:adbroot_data_file:s0

# Bash
/(system_ext|system/system_ext)/bin/bash          u:object_r:shell_exec:s0

# Pocket judge
/sys/kernel/pocket_judge(/.*)?	u:object_r:pocket_judge_sysfs:s0

# Sandbox
/data/system_ce/[0-9]*/sandbox/vault(/.*)?  u:object_r:ax_sandbox_vault_file:s0

# Native OTA mount broker; executes only from the privileged updater.
/system/bin/backuptool_broker  u:object_r:backuptool_broker_exec:s0

# Offline tmpfs staging helper; exact native caller checks guard each mode.
/system/bin/backuptool_store u:object_r:backuptool_store_exec:s0
/system/bin/backuptool_staged\.sh u:object_r:postinstall_exec:s0
