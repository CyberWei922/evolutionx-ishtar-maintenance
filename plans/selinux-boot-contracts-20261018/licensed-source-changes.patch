--- a/device/xiaomi/ishtar/properties/platform-system.prop
+++ b/device/xiaomi/ishtar/properties/platform-system.prop
@@ -12,3 +12,7 @@
 # Preserve two remaining legacy defaults through system initialization.
 audio.sys.offload.pstimeout.secs=3
